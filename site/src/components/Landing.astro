---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  lang: "ru" | "en";
}

type HudState = "recording" | "processing" | "inserted";

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (path: string) => `${base}/${path}`;
// Screenshots are rendered per interface language: "app-idle.png" (RU) and "app-idle-en.png" (EN).
const localized = (name: string) => asset(`${name}${lang === "en" ? "-en" : ""}.png`);
const releaseUrl = "https://github.com/KROU4/Whisper-Tray/releases/latest";
const downloadUrls = {
  windows: "https://github.com/KROU4/Whisper-Tray/releases/download/v1.3.1/WhisperTray-1.3.1.msi",
  macos: "https://github.com/KROU4/Whisper-Tray/releases/download/v1.3.1/WhisperTray-1.3.1.dmg",
  linux: "https://github.com/KROU4/Whisper-Tray/releases/download/v1.3.1/whispertray_1.3.1-1.ubuntu-noble_amd64.deb",
};
const repoUrl = "https://github.com/KROU4/Whisper-Tray";

// Natural pixel sizes of the cropped status-capsule screenshots in public/.
const hudWidths: Record<"ru" | "en", Record<HudState, number>> = {
  ru: { recording: 205, processing: 158, inserted: 150 },
  en: { recording: 211, processing: 167, inserted: 150 },
};
const hudHeight = 46;

const copy = lang === "ru" ? {
  title: "WhisperTray — голосовая диктовка для Windows, macOS и Linux",
  description: "WhisperTray превращает речь в текст и вставляет его в любое приложение. Локальный приватный режим или быстрое облачное распознавание с ИИ-шлифовкой текста.",
  navProfiles: "Режимы",
  navPolish: "ИИ-шлифовка",
  navHow: "Как работает",
  navFaq: "Вопросы",
  language: "EN",
  languageHref: `${base}/en/`,
  releasePill: "ИИ-шлифовка текста в режиме «Скорость»",
  heroTop: "Говорите.",
  heroAccent: "WhisperTray",
  heroBottom: "напечатает.",
  heroText: "Быстрая диктовка в любом приложении",
  downloads: {
    windows: "Скачать для Windows",
    macos: "Скачать для Mac",
    linux: "Скачать для Linux",
  },
  github: "Смотреть на GitHub",
  facts: ["Windows · macOS · Linux", "Локальное распознавание", "Без подписки"],
  heroShotAlt: "Главное окно WhisperTray во время записи: таймер и уровень микрофона",
  hudAlt: {
    recording: "Капсула статуса: идёт запись, таймер 0:14 и уровень микрофона",
    processing: "Капсула статуса: текст распознаётся",
    inserted: "Капсула статуса: текст вставлен",
  },
  profilesTitle: "Два режима. Один голосовой помощник.",
  profilesLead: "Вы сами решаете, что важнее прямо сейчас: полная автономность или максимальная скорость.",
  privacy: "Приватность",
  privacyText: "Весь процесс происходит локально на вашем компьютере. После загрузки модели интернет не нужен, аудио и текст никуда не отправляются.",
  speed: "Скорость",
  speedText: "Распознавание через Groq с минимальной задержкой. Аудио отправляется в облако только после явного выбора этого режима.",
  speedNote: "Новое: ИИ-шлифовка текста",
  polish: {
    eyebrow: "Новое в 1.3 · режим «Скорость»",
    title: "Говорите как обычно. Текст будет аккуратным.",
    lead: "После распознавания Groq Whisper текст проходит через языковую модель Groq — с тем же бесплатным ключом. Модель получает только расшифровку, аудио ей не передаётся.",
    points: [
      "Расставляет знаки препинания и сохраняет ваши формулировки",
      "Убирает «э», «ну», «как бы» и оговорки: «в четверг, нет, в пятницу» → «в пятницу»",
      "Делит длинную диктовку на абзацы, перечисления оформляет списком",
      "Пишет числа цифрами и исправляет неверно распознанные слова",
      "Не переводит текст и не отвечает на него",
      "Если модель недоступна, вставится исходная расшифровка",
    ],
    meta: ["≈0,5 с дополнительно", "Отключается в настройках", "В режиме «Приватность» не используется"],
    demoLabel: "Пример ИИ-шлифовки",
    rawLabel: "Распознано",
    raw: [
      { text: "ну короче э", filler: true },
      { text: " мне нужно чтобы ты сделал отчёт до пятницы", filler: false },
    ],
    stepLabel: "ИИ-шлифовка",
    stepMeta: "Groq · только текст",
    cleanLabel: "Вставлено",
    clean: "Мне нужно, чтобы ты сделал отчёт до пятницы.",
  },
  howEyebrow: "Один хоткей",
  howTitle: "Меньше переключений. Больше готового текста.",
  howLead: "WhisperTray работает поверх других приложений: вы не покидаете документ, чат или форму, в которой уже находитесь.",
  steps: [
    {
      title: "Нажмите",
      text: "<kbd>Win</kbd> + <kbd>Alt</kbd> в любой программе — или задайте своё сочетание в настройках.",
      huds: [] as HudState[],
    },
    {
      title: "Говорите",
      text: "Капсула статуса показывает таймер и уровень микрофона. Случайные записи без речи никуда не отправляются.",
      huds: ["recording"] as HudState[],
    },
    {
      title: "Продолжайте работать",
      text: "Текст вставится туда, где стоит курсор. Текст с абзацами вставляется целиком, поэтому сообщение в чате не уйдёт раньше времени.",
      huds: ["processing", "inserted"] as HudState[],
    },
  ],
  idleShotAlt: "Главное окно WhisperTray с последним распознанным текстом",
  newBadge: "Новое",
  features: [
    { icon: "mdi:monitor-cellphone", title: "В любой программе", text: "Почта, браузер, мессенджер, редактор или CRM — достаточно активного поля ввода.", isNew: false },
    { icon: "mdi:shield-lock-outline", title: "Без скрытой смены приватности", text: "Локальный режим никогда не отправляет аудио в облако. Переключение всегда видно.", isNew: false },
    { icon: "mdi:check-decagram-outline", title: "Надёжная диктовка", text: "Удержание клавиши срабатывает при любом порядке отпускания, тихие записи не отправляются, а абзацы не отправляют сообщение раньше времени.", isNew: true },
    { icon: "mdi:record-circle-outline", title: "Обновлённый интерфейс", text: "Спокойная капсула статуса вместо всплывающих окон об ошибках, более простые настройки и первый запуск.", isNew: true },
    { icon: "mdi:keyboard-outline", title: "Горячая клавиша без синтаксиса", text: "Нажмите «Изменить», затем новое сочетание — WhisperTray сохранит его сам.", isNew: false },
    { icon: "mdi:translate", title: "Русский и English", text: "Интерфейс и документация доступны на двух языках, язык распознавания настраивается отдельно.", isNew: false },
  ],
  downloadEyebrow: "Открытый исходный код · v1.3.1",
  downloadTitle: "Скачайте WhisperTray и начните диктовать.",
  downloadText: "В версии 1.3.0 установщик для Windows стал проще. Пакеты для Windows, macOS и Linux собираются автоматически в GitHub Releases.",
  allDownloads: "Открыть все загрузки",
  source: "Исходный код",
  faqTitle: "Коротко о важном",
  faqs: [
    ["Нужен ли интернет?", "Для локального режима — только при первой загрузке модели. Облачному режиму Groq интернет нужен всегда."],
    ["Куда уходит текст при ИИ-шлифовке и это бесплатно?", "Шлифовка работает только в режиме «Скорость»: в Groq отправляется распознанный текст (не аудио) с вашим собственным ключом — тем же, что и для распознавания. WhisperTray ничего за это не берёт, действуют лимиты бесплатного тарифа Groq. В режиме «Приватность» текст не покидает компьютер, а шлифовку можно отключить в настройках."],
    ["Где хранится ключ Groq?", "Не в config.json. На Windows ключ сохраняется в системном менеджере учётных данных."],
    ["Сохраняется ли история диктовок?", "По умолчанию нет. Локальную историю можно включить отдельно и выбрать срок хранения."],
    ["Какие системы поддерживаются?", "Целевые пакеты собираются для Windows, macOS и Linux. На Wayland глобальные горячие клавиши зависят от ограничений окружения."],
  ],
  footerText: "Диктовка в любой программе.",
  footerDocs: "Документация",
} : {
  title: "WhisperTray — voice dictation for Windows, macOS and Linux",
  description: "WhisperTray turns speech into text and inserts it into any application. Choose private local recognition or fast cloud transcription with AI text polishing.",
  navProfiles: "Modes",
  navPolish: "AI polishing",
  navHow: "How it works",
  navFaq: "FAQ",
  language: "RU",
  languageHref: `${base}/`,
  releasePill: "AI text polishing in Speed mode",
  heroTop: "Speak.",
  heroAccent: "WhisperTray",
  heroBottom: "will type.",
  heroText: "Fast dictation in any application",
  downloads: {
    windows: "Download for Windows",
    macos: "Download for Mac",
    linux: "Download for Linux",
  },
  github: "View on GitHub",
  facts: ["Windows · macOS · Linux", "Local recognition", "No subscription"],
  heroShotAlt: "WhisperTray main window while recording, with timer and microphone level",
  hudAlt: {
    recording: "Status capsule: recording, 0:14 timer and microphone level",
    processing: "Status capsule: transcribing",
    inserted: "Status capsule: text inserted",
  },
  profilesTitle: "Two modes. One voice assistant.",
  profilesLead: "Choose what matters right now: complete autonomy or maximum speed.",
  privacy: "Privacy",
  privacyText: "Everything runs locally on your computer. Once the model is downloaded, no internet is required, and neither audio nor text leaves the device.",
  speed: "Speed",
  speedText: "Groq transcription with minimal latency. Audio is sent to the cloud only after you explicitly choose this mode.",
  speedNote: "New: AI text polishing",
  polish: {
    eyebrow: "New in 1.3 · Speed mode",
    title: "Speak naturally. Get tidy text.",
    lead: "After Groq Whisper transcribes your speech, a Groq language model cleans up the text with the same free Groq key. The model receives only the transcript, never audio.",
    points: [
      "Adds punctuation and keeps your own wording",
      "Removes fillers and slips: “Thursday, no actually Friday” → “Friday”",
      "Splits long dictation into paragraphs and turns enumerations into lists",
      "Writes numbers as digits and fixes misrecognized words",
      "Never translates or replies to your text",
      "If it is unavailable, the original transcript is inserted",
    ],
    meta: ["Adds about 0.5 s", "Can be turned off in Settings", "Not used in Privacy mode"],
    demoLabel: "AI polishing example",
    rawLabel: "Recognized",
    raw: [
      { text: "um so", filler: true },
      { text: " I think we should ", filler: false },
      { text: "uh", filler: true },
      { text: " move the meeting to Thursday", filler: false },
    ],
    stepLabel: "AI polishing",
    stepMeta: "Groq · text only",
    cleanLabel: "Inserted",
    clean: "I think we should move the meeting to Thursday.",
  },
  howEyebrow: "One hotkey",
  howTitle: "Fewer context switches. More finished text.",
  howLead: "WhisperTray works on top of your other apps, so you stay in the document, chat, or form you are already using.",
  steps: [
    {
      title: "Press",
      text: "<kbd>Win</kbd> + <kbd>Alt</kbd> in any app, or capture your own shortcut in Settings.",
      huds: [] as HudState[],
    },
    {
      title: "Speak",
      text: "A status capsule shows the timer and microphone level. Accidental recordings with no speech are never sent.",
      huds: ["recording"] as HudState[],
    },
    {
      title: "Keep working",
      text: "The text appears wherever your cursor is. Multi-line text is pasted in one go, so chat messages are not sent early.",
      huds: ["processing", "inserted"] as HudState[],
    },
  ],
  idleShotAlt: "WhisperTray main window showing the latest transcription",
  newBadge: "New",
  features: [
    { icon: "mdi:monitor-cellphone", title: "Works in any app", text: "Email, browser, messenger, editor, or CRM — all you need is an active text field.", isNew: false },
    { icon: "mdi:shield-lock-outline", title: "Privacy never changes silently", text: "Local mode never uploads audio. Every mode switch stays visible.", isNew: false },
    { icon: "mdi:check-decagram-outline", title: "Reliable dictation", text: "Hold-to-talk works whatever order you release the keys in, silent recordings are not sent, and paragraphs never send a chat message early.", isNew: true },
    { icon: "mdi:record-circle-outline", title: "Redesigned interface", text: "A calm status capsule instead of tray pop-ups on errors, plus simpler settings and onboarding.", isNew: true },
    { icon: "mdi:keyboard-outline", title: "No shortcut syntax", text: "Select Change, press a new combination, and WhisperTray stores it for you.", isNew: false },
    { icon: "mdi:translate", title: "Russian and English", text: "The interface and documentation are bilingual, while recognition language is configured separately.", isNew: false },
  ],
  downloadEyebrow: "Open source · v1.3.1",
  downloadTitle: "Download WhisperTray and start dictating.",
  downloadText: "Version 1.3.0 ships a streamlined Windows installer. Packages for Windows, macOS, and Linux are built automatically in GitHub Releases.",
  allDownloads: "View all downloads",
  source: "Source code",
  faqTitle: "The essentials",
  faqs: [
    ["Does it need internet?", "Local mode only needs a connection for the first model download. Groq cloud mode always requires internet."],
    ["Where does polished text go, and is it free?", "Polishing runs only in Speed mode: the recognized text (not audio) is sent to Groq with your own key, the same one used for transcription. WhisperTray charges nothing for it; Groq free tier limits apply. In Privacy mode text never leaves your computer, and polishing can be turned off in Settings."],
    ["Where is the Groq key stored?", "Not in config.json. On Windows it is stored in the system credential manager."],
    ["Does WhisperTray save dictation history?", "Not by default. Local history is optional and includes a configurable retention period."],
    ["Which systems are supported?", "Release packages target Windows, macOS, and Linux. On Wayland, global shortcuts depend on desktop environment restrictions."],
  ],
  footerText: "Dictation in any application.",
  footerDocs: "Documentation",
};
---

<BaseLayout lang={lang} title={copy.title} description={copy.description} canonicalPath={lang === "ru" ? "/" : "/en/"}>
  <a class="skip-link" href="#main">{lang === "ru" ? "К содержанию" : "Skip to content"}</a>
  <header class="site-header">
    <a class="brand" href={lang === "ru" ? `${base}/` : `${base}/en/`} aria-label="WhisperTray">
      <img src={asset("logo.png")} alt="" width="38" height="38" />
      <span>WhisperTray</span>
    </a>
    <nav aria-label={lang === "ru" ? "Основная навигация" : "Main navigation"}>
      <a href="#profiles">{copy.navProfiles}</a>
      <a href="#polish">{copy.navPolish}</a>
      <a href="#how">{copy.navHow}</a>
      <a href="#faq">{copy.navFaq}</a>
    </nav>
    <div class="header-actions">
      <a class="language-link" href={copy.languageHref} lang={lang === "ru" ? "en" : "ru"}>{copy.language}</a>
      <a
        class="button button-small platform-download"
        href={downloadUrls.windows}
        data-download-windows={downloadUrls.windows}
        data-download-macos={downloadUrls.macos}
        data-download-linux={downloadUrls.linux}
        data-label-windows={copy.downloads.windows}
        data-label-macos={copy.downloads.macos}
        data-label-linux={copy.downloads.linux}
      ><span data-download-label>{copy.downloads.windows}</span></a>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <img class="hero-atmosphere" src={asset("hero-wave.png")} alt="" width="2048" height="1024" fetchpriority="high" />
      <div class="hero-grid shell">
        <div class="hero-copy">
          <a class="release-pill" href="#polish">
            <span class="release-pill-tag">1.3</span>
            <span>{copy.releasePill}</span>
            <Icon name="mdi:arrow-right" aria-hidden="true" />
          </a>
          <h1 id="hero-title">
            <span>{copy.heroTop}</span>
            <strong>{copy.heroAccent}</strong>
            <span>{copy.heroBottom}</span>
          </h1>
          <p class="hero-lead">{copy.heroText}</p>
          <div class="hero-actions">
            <a
              class="button button-primary platform-download"
              href={downloadUrls.windows}
              data-download-windows={downloadUrls.windows}
              data-download-macos={downloadUrls.macos}
              data-download-linux={downloadUrls.linux}
              data-label-windows={copy.downloads.windows}
              data-label-macos={copy.downloads.macos}
              data-label-linux={copy.downloads.linux}
            >
              <span data-download-icon="windows"><Icon name="mdi:microsoft-windows" aria-hidden="true" /></span>
              <span data-download-icon="macos" hidden><Icon name="mdi:apple" aria-hidden="true" /></span>
              <span data-download-icon="linux" hidden><Icon name="mdi:linux" aria-hidden="true" /></span>
              <span data-download-label>{copy.downloads.windows}</span>
            </a>
            <a class="button button-secondary" href={repoUrl}>
              <Icon name="mdi:github" aria-hidden="true" />
              {copy.github}
            </a>
          </div>
          <ul class="hero-facts" aria-label={lang === "ru" ? "Основные преимущества" : "Key benefits"}>
            {copy.facts.map((fact) => <li>{fact}</li>)}
          </ul>
        </div>
        <div class="product-shot">
          <div class="product-frame">
            <img src={localized("app-recording")} alt={copy.heroShotAlt} width="480" height="600" />
            <div class="hero-hud">
              <img
                src={localized("hud-recording")}
                alt={copy.hudAlt.recording}
                width={hudWidths[lang].recording}
                height={hudHeight}
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="profiles section shell" id="profiles" aria-labelledby="profiles-title">
      <div class="section-heading centered">
        <p class="eyebrow">{lang === "ru" ? "Выбор остаётся за вами" : "You stay in control"}</p>
        <h2 id="profiles-title">{copy.profilesTitle}</h2>
        <p>{copy.profilesLead}</p>
      </div>
      <div class="profile-grid">
        <article>
          <Icon name="mdi:shield-lock-outline" aria-hidden="true" />
          <div>
            <h3>{copy.privacy}</h3>
            <p>{copy.privacyText}</p>
          </div>
        </article>
        <article>
          <Icon name="mdi:lightning-bolt-outline" aria-hidden="true" />
          <div>
            <h3>{copy.speed}</h3>
            <p>{copy.speedText}</p>
            <a class="profile-note" href="#polish">
              <Icon name="mdi:auto-fix" aria-hidden="true" />
              <span>{copy.speedNote}</span>
            </a>
          </div>
        </article>
      </div>
    </section>

    <section class="polish section" id="polish" aria-labelledby="polish-title">
      <div class="shell polish-grid">
        <div class="polish-copy">
          <p class="eyebrow">{copy.polish.eyebrow}</p>
          <h2 id="polish-title">{copy.polish.title}</h2>
          <p class="polish-lead">{copy.polish.lead}</p>
          <ul class="polish-points">
            {copy.polish.points.map((point) => (
              <li><Icon name="mdi:check" aria-hidden="true" /><span>{point}</span></li>
            ))}
          </ul>
          <ul class="polish-meta">
            {copy.polish.meta.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <figure class="polish-demo" aria-label={copy.polish.demoLabel} data-polish-demo>
          <div class="demo-block">
            <p class="demo-label">
              <span>{copy.polish.rawLabel}</span>
              <span class="demo-chip">Whisper</span>
            </p>
            <p class="demo-raw" lang={lang}>
              {copy.polish.raw.map((part) => part.filler ? <del>{part.text}</del> : part.text)}
            </p>
          </div>
          <div class="demo-step" aria-hidden="true">
            <span class="demo-spinner"></span>
            <span class="demo-step-label">{copy.polish.stepLabel}</span>
            <span class="demo-step-meta">{copy.polish.stepMeta}</span>
          </div>
          <div class="demo-block demo-block-clean">
            <p class="demo-label demo-label-success">
              <Icon name="mdi:check" aria-hidden="true" />
              <span>{copy.polish.cleanLabel}</span>
            </p>
            <p class="demo-clean" lang={lang}>{copy.polish.clean}</p>
          </div>
        </figure>
      </div>
    </section>

    <section class="how section" id="how" aria-labelledby="how-title">
      <div class="shell how-grid">
        <div class="how-copy">
          <p class="eyebrow">{copy.howEyebrow}</p>
          <h2 id="how-title">{copy.howTitle}</h2>
          <p>{copy.howLead}</p>
          <ol class="steps">
            {copy.steps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p set:html={step.text} />
                  {step.huds.length > 0 && (
                    <div class="step-hud">
                      {step.huds.map((state) => (
                        <img
                          src={localized(`hud-${state}`)}
                          alt={copy.hudAlt[state]}
                          width={hudWidths[lang][state]}
                          height={hudHeight}
                          loading="lazy"
                        />
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="idle-shot">
          <img src={localized("app-idle")} alt={copy.idleShotAlt} width="480" height="600" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="features section shell" aria-label={lang === "ru" ? "Возможности" : "Features"}>
      <div class="feature-grid">
        {copy.features.map((feature) => (
          <article>
            <Icon name={feature.icon} aria-hidden="true" />
            <h3>
              {feature.title}
              {feature.isNew && <span class="new-badge">{copy.newBadge}</span>}
            </h3>
            <p>{feature.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="download section shell" id="download" aria-labelledby="download-title">
      <div>
        <p class="eyebrow">{copy.downloadEyebrow}</p>
        <h2 id="download-title">{copy.downloadTitle}</h2>
        <p>{copy.downloadText}</p>
      </div>
      <div class="download-actions">
        <a class="button button-primary" href={releaseUrl}>
          <Icon name="mdi:download" aria-hidden="true" />
          {copy.allDownloads}
        </a>
        <a class="button button-secondary" href={repoUrl}>
          <Icon name="mdi:github" aria-hidden="true" />
          {copy.source}
        </a>
      </div>
    </section>

    <section class="faq section shell" id="faq" aria-labelledby="faq-title">
      <div class="section-heading"><p class="eyebrow">FAQ</p><h2 id="faq-title">{copy.faqTitle}</h2></div>
      <div class="faq-list">
        {copy.faqs.map(([question, answer], index) => (
          <details open={index === 0}>
            <summary>{question}<Icon name="mdi:plus" aria-hidden="true" /></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="site-footer shell">
    <div class="brand footer-brand"><img src={asset("logo.png")} alt="" width="32" height="32" /><span>WhisperTray</span></div>
    <p>{copy.footerText}</p>
    <div>
      <a href={lang === "ru" ? `${base}/en/` : `${base}/`}>{copy.language}</a>
      <a href={lang === "ru" ? `${repoUrl}#readme` : `${repoUrl}/blob/main/README.en.md`}>{copy.footerDocs}</a>
      <a href={repoUrl}>GitHub</a>
    </div>
  </footer>

  <script>
    import { configurePlatformDownloads } from "../scripts/platform-download.mjs";

    configurePlatformDownloads();

    document.querySelectorAll("details").forEach((detail) => {
      detail.addEventListener("toggle", () => {
        const icon = detail.querySelector("svg");
        if (icon) icon.style.transform = detail.open ? "rotate(45deg)" : "rotate(0deg)";
      });
    });

    // Replay the before/after polishing demo once it scrolls into view.
    // Without JS (or with reduced motion) the final, polished state is shown as is.
    const demo = document.querySelector<HTMLElement>("[data-polish-demo]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (demo && !reduceMotion && "IntersectionObserver" in window) {
      demo.classList.add("is-armed");
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          demo.classList.add("is-playing");
          observer.disconnect();
        }
      }, { threshold: 0.55 });
      observer.observe(demo);
    }
  </script>
</BaseLayout>
